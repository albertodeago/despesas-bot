{
	"name": "despesas-bot",
	"version": "1.13.3",
	"description": "A telegram bot to track your expenses on a google sheet",
	"main": "main.js",
	"scripts": {
		"dev": "npm run build && node ./dist/main.js",
		"build": "esbuild --bundle ./src/main.ts --platform=node --target=node24 --outfile=./dist/main.js",
		"ts:check": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest watch",
		"test:memory": "node scripts/memory-smoke.cjs",
		"lint": "biome check .",
		"lint:apply": "biome check --write ."
	},
	"author": "Alberto De Agostini",
	"license": "ISC",
	"dependencies": {
		"@googleapis/sheets": "18.1.2",
		"@isaacs/ttlcache": "2.1.5",
		"dotenv": "17.2.3",
		"google-auth-library": "11.3.2",
		"node-telegram-bot-api": "0.67.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@flydotio/dockerfile": "0.7.10",
		"@types/node": "24.0.10",
		"@types/node-telegram-bot-api": "0.64.13",
		"@vitest/coverage-v8": "4.0.17",
		"esbuild": "0.27.2",
		"nock": "14.0.17",
		"typescript": "5.9.3",
		"vitest": "4.0.17"
	}
}
